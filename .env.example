# TijusPro LMS — backend environment variables
# Copy to .env (which is gitignored) and fill in. The backend reads process.env.

# Server
PORT=8000
SESSION_SECRET=change-this-to-a-long-random-string

# LiveKit (SFU) — enables large webinar-style sessions (50-100+ participants).
# Create a free project at https://cloud.livekit.io (or self-host) and paste the
# WebSocket URL + API key/secret here. Then, as superadmin, set the video
# provider to "LiveKit" in Settings.
# Credentials are intentionally kept in env (NOT the database).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
