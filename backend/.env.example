# ---- Database (MySQL / MariaDB) ----
# On Hostinger the Node app runs on the same host as MySQL, so DB_HOST=localhost.
# For local testing or remote migration, point these at the reachable MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u314034055_lms
DB_PASSWORD=change-me
DB_NAME=u314034055_lms
DB_POOL=10

# ---- App ----
PORT=8000
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Uploads (recordings, course materials, avatars) — IMPORTANT ----
# Absolute path OUTSIDE the deployed app folder. If unset, files are stored in
# backend/uploads and are WIPED on every deploy that replaces the project tree —
# recordings then show as "Missing" in the app. On Hostinger, point this at a
# directory in your home folder that deploys never touch, then restart Node.
UPLOADS_ROOT=/home/u314034055/lms-uploads

# ---- LiveKit (optional, for large video sessions) ----
# These are the default/fallback credentials. A LiveKit server added in
# Settings → Integrations is stored in the DB and overrides these without a
# restart, so configuring it here is optional.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- HubSpot (optional default token for the Contacts page) ----
HUBSPOT_TOKEN=

# ---- Kajabi (optional defaults for the Kajabi Contacts page) ----
# Credentials can also be added in Settings → Integrations → Kajabi, which
# override these. KAJABI_API_BASE only needs changing if Kajabi's API host differs.
KAJABI_CLIENT_ID=
KAJABI_CLIENT_SECRET=
KAJABI_API_BASE=https://api.kajabi.com
