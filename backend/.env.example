# ---- Database (MySQL / MariaDB) ----
# On Hostinger the Node app runs on the same host as MySQL, so DB_HOST=localhost.
# For local testing or remote migration, point these at the reachable MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u314034055_lms
DB_PASSWORD=change-me
DB_NAME=u314034055_lms
DB_POOL=10

# Path to the legacy SQLite file (only used by migrate-sqlite-to-mysql.js)
# SQLITE_PATH=./backend/tijuspro.db

# ---- App ----
PORT=8000
SESSION_SECRET=change-this-to-a-long-random-string

# ---- LiveKit (optional, for large video sessions) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- HubSpot (optional default token for the Contacts page) ----
HUBSPOT_TOKEN=
